# MCP Bearer 鉴权（≥16 字符）
MCP_BEARER_TOKEN=change-me-to-a-long-random-token

# HTTP 监听
MCP_HOST=0.0.0.0
MCP_PORT=3101
MCP_PATH=/mcp

# --- 方案 3：lark-cli 同款应用 Bot 上云（推荐个人账号）---
LARK_APP_ID=cli_aab9314aaf64dbb5
LARK_APP_SECRET=从飞书开放平台或本机 keychain 复制
LARK_DEFAULT_IDENTITY=bot
LARK_USE_CLI=false
LARK_NOTIFY_CHAT_ID=oc_xxx
LARK_NOTIFY_ENABLED=false

# 不要与方案 3 同时使用（仅本机 lark-cli 用户身份时用）
# LARK_USER_ACCESS_TOKEN=
