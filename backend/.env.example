# Copy to backend/.env for local development and production deploy.
# CI does not read this file — see .github/workflows/ci.yml and tests/conftest.py.

# --- LLM (OpenAI-compatible) ---
API_KEY=your_api_key
MODEL_BASE_URL=https://token.sensenova.cn/v1
BASE_MODEL=deepseek-v4-flash
COPYWRITE_MODEL=THUDM/GLM-Z1-9B-0414
GENARATION_MODEL=internlm/internlm2_5-7b-chat
PLAN_MODEL=THUDM/GLM-4.1V-9B-Thinking
INTENT_MODEL=Qwen/Qwen3-8B

# --- Embeddings & image (SiliconFlow) ---
SILICONFLOW_API_KEY=your_siliconflow_key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDING_MODEL=BAAI/bge-large-zh-v1.5
IMAGE_MODEL=Kwai-Kolors/Kolors

# --- Optional ---
REPLICATE_API_KEY=

# --- LangSmith (optional tracing) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=xhs-multi-agent

# --- Project memory DB (default: SQLite under app/data/) ---
# DATABASE_URL=sqlite+aiosqlite:///./app/data/memory.db

# --- 飞书 IM / OAuth（与 mcp-lark/.env 同步）---
# LARK_APP_ID=cli_xxx
# LARK_APP_SECRET=xxx
# LARK_DEFAULT_IDENTITY=bot
# LARK_USE_CLI=false
# LARK_NOTIFY_CHAT_ID=oc_xxx
# LARK_NOTIFY_ENABLED=false
# LARK_OAUTH_REDIRECT_URI=http://localhost:8000/lark/oauth/callback

# --- 微博自动发布 / X 同步（Playwright）---
# WEIBO_PUBLISH_ENABLED=false
# WEIBO_PUBLISH_AUTO_ON_COMPLETE=true
# WEIBO_PUBLISH_DRY_RUN=false
# WEIBO_PUBLISH_SKIP_REVIEW=false
# WEIBO_PUBLISH_HEADLESS=true
# 发布/状态检测是否 headless；Studio「登录微博」始终打开可见浏览器供用户操作
# WEIBO_BROWSER_CHANNEL=chrome
# 推荐使用本机 Google Chrome 登录（降低微博图标验证码风控）；留空则用 Playwright 自带 Chromium
# WEIBO_PUBLISH_TIMEOUT_MS=45000
# BROWSER_USE_PROFILE_PATH=/path/to/weibo-profiles-root
# WEIBO_PUBLISH_PROFILE_PATH=/path/to/weibo-profiles-root
# WEIBO_OAUTH_CLIENT_ID=
# WEIBO_OAUTH_CLIENT_SECRET=
# WEIBO_OAUTH_CALLBACK_URL=http://localhost:8000/social/weibo/oauth/callback
# WEIBO_SYNC_USER_ID=studio_username_for_x_sync
# 注意：路径名不要包含 chrome，否则登录态可能无法持久化
# 一次性登录：cd backend && python3 scripts/weibo_login.py
# X_SYNC_ENABLED=false
# X_SYNC_USERNAME=your_x_handle
# X_SYNC_PROFILE_PATH=/path/to/chrome-x-profile
# X_SYNC_INTERVAL_SECONDS=300

# --- X 自动发布（Playwright Profile 浏览器，需在浏览器中登录 X）---
# X_PUBLISH_ENABLED=false
# X_PUBLISH_DRY_RUN=false
# X_PUBLISH_SKIP_REVIEW=false
# X_PUBLISH_HEADLESS=false
# 生产 Docker 默认 headless；本地 Mac 可 false 以打开可见浏览器
# SOCIAL_OAUTH_BROWSERLESS=1  # 强制 OAuth 在用户浏览器完成（远程服务器推荐）
# SOCIAL_OAUTH_INTERACTIVE=1  # Linux 桌面强制可见浏览器
# X_PUBLISH_TIMEOUT_MS=45000
# X_PUBLISH_PROFILE_PATH=/path/to/x-profile
# 注意：路径名不要包含 chrome，否则登录态可能无法持久化
# X_BROWSER_CHANNEL=chrome
# 推荐使用本机 Google Chrome 登录；留空则用 Playwright 自带 Chromium

# --- X OAuth 2.0（Profile 内授权 + Web UI 发帖，token 仅用于身份绑定）---
# X_OAUTH_CLIENT_ID=your_x_app_client_id
# X_OAUTH_CLIENT_SECRET=your_x_app_client_secret
# X_OAUTH_CALLBACK_URL=http://localhost:8000/social/x/oauth/callback
# X_OAUTH_SCOPES=users.read offline.access
# X_OAUTH_STATE_SECRET=
# X_HTTP_PROXY=
