# Copy to backend/.env for local development and production deploy.
# CI does not read this file — see .github/workflows/ci.yml and tests/conftest.py.

# --- LLM (OpenAI-compatible) ---
API_KEY=your_api_key
MODEL_BASE_URL=https://token.sensenova.cn/v1
BASE_MODEL=deepseek-v4-flash
COPYWRITE_MODEL=THUDM/GLM-Z1-9B-0414
GENARATION_MODEL=internlm/internlm2_5-7b-chat
PLAN_MODEL=THUDM/GLM-4.1V-9B-Thinking
INTENT_MODEL=Qwen/Qwen3-8B

# --- Embeddings & image (SiliconFlow) ---
SILICONFLOW_API_KEY=your_siliconflow_key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDING_MODEL=BAAI/bge-large-zh-v1.5
IMAGE_MODEL=Kwai-Kolors/Kolors

# --- Optional ---
REPLICATE_API_KEY=

# --- LangSmith (optional tracing) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=xhs-multi-agent

# --- Project memory DB (default: SQLite under app/data/) ---
# DATABASE_URL=sqlite+aiosqlite:///./app/data/memory.db

# --- 飞书 IM / OAuth（与 mcp-lark/.env 同步）---
# LARK_APP_ID=cli_xxx
# LARK_APP_SECRET=xxx
# LARK_DEFAULT_IDENTITY=bot
# LARK_USE_CLI=false
# LARK_NOTIFY_CHAT_ID=oc_xxx
# LARK_NOTIFY_ENABLED=false
# LARK_OAUTH_REDIRECT_URI=http://localhost:8000/lark/oauth/callback
