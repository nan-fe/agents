# Copy to backend/.env for local development and production deploy.
# CI does not read this file — see .github/workflows/ci.yml and tests/conftest.py.

# --- LLM (OpenAI-compatible) ---
API_KEY=your_api_key
MODEL_BASE_URL=https://token.sensenova.cn/v1
BASE_MODEL=deepseek-v4-flash
COPYWRITE_MODEL=THUDM/GLM-Z1-9B-0414
GENARATION_MODEL=internlm/internlm2_5-7b-chat
PLAN_MODEL=THUDM/GLM-4.1V-9B-Thinking
INTENT_MODEL=Qwen/Qwen3-8B

# --- Embeddings & image (SiliconFlow) ---
SILICONFLOW_API_KEY=your_siliconflow_key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDING_MODEL=BAAI/bge-large-zh-v1.5
IMAGE_MODEL=Kwai-Kolors/Kolors

# --- Optional ---
REPLICATE_API_KEY=

# --- LangSmith (optional tracing) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=xhs-multi-agent

# --- Project memory DB (default: SQLite under app/data/) ---
# DATABASE_URL=sqlite+aiosqlite:///./app/data/memory.db

# --- 飞书 IM / OAuth（与 mcp-lark/.env 同步）---
# LARK_APP_ID=cli_xxx
# LARK_APP_SECRET=xxx
# LARK_DEFAULT_IDENTITY=bot
# LARK_USE_CLI=false
# LARK_NOTIFY_CHAT_ID=oc_xxx
# LARK_NOTIFY_ENABLED=false
# LARK_OAUTH_REDIRECT_URI=http://localhost:8000/lark/oauth/callback

# --- 微博自动发布 / X 同步（browser-use 主流程 + 可选 Playwright）---
# WEIBO_PUBLISH_ENABLED=false
# WEIBO_PUBLISH_AUTO_ON_COMPLETE=true
# WEIBO_PUBLISH_ENGINE=browser_use
# WEIBO_PUBLISH_DRY_RUN=false
# WEIBO_PUBLISH_SKIP_REVIEW=false
# WEIBO_PUBLISH_HEADLESS=true
# WEIBO_PUBLISH_TIMEOUT_MS=45000
# BROWSER_USE_PROFILE_PATH=/path/to/weibo-profile
# 注意：路径名不要包含 chrome，否则 browser-use 会复制到临时目录导致登录态丢失
# 一次性登录：cd backend && python3 scripts/weibo_login.py
# BROWSER_USE_FALLBACK_ENABLED=true
# browser-use 可选：pip install -r requirements-social.txt -i https://pypi.org/simple
# 使用项目已有 LLM（与创作台相同，无需 OpenAI 官方 Key）：
# BROWSER_USE_LLM_MODEL=deepseek-v4-flash
# 仅在使用 Browser Use Cloud 时才需要：
# BROWSER_USE_API_KEY=
# X_SYNC_ENABLED=false
# X_SYNC_USERNAME=your_x_handle
# X_SYNC_PROFILE_PATH=/path/to/chrome-x-profile
# X_SYNC_INTERVAL_SECONDS=300
