# Copy to .env for local development (Prisma CLI and Next.js both read .env)
# Auth.js — required in production; leave unset in local dev (uses built-in dev secret)
# Generate: openssl rand -base64 32
# AUTH_SECRET=

# OAuth — create apps in GitHub / Google Cloud Console
# Local callback URLs:
#   GitHub: http://localhost:3000/api/auth/callback/github
#   Google: http://localhost:3000/api/auth/callback/google
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# Production base URL (affects OAuth callback URL generation)
# AUTH_URL=https://your-domain.com

# PostgreSQL (local: docker compose up postgres -d)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/xhs_auth

# Upstream services for Next.js rewrites
STUDIO_UPSTREAM_URL=http://localhost:5173
API_UPSTREAM_URL=http://localhost:8000

# Share page ISR (fetch cache; page revalidate is in share/[shareId]/page.tsx)
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# Better Stack Error Tracking (Sentry-compatible SDK)
# https://betterstack.com/docs/errors/collecting-errors/sentry-sdk/
# DSN format: https://$APPLICATION_TOKEN@$INGESTING_HOST/1
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_APPLICATION_ID=frontend-share
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0.1
