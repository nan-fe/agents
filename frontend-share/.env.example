# Copy to .env for local development (Prisma CLI and Next.js both read .env)
# Auth.js
AUTH_SECRET=replace-with-openssl-rand-base64-32

# PostgreSQL (local: docker compose up postgres -d)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/xhs_auth

# Upstream services for Next.js rewrites
STUDIO_UPSTREAM_URL=http://localhost:5173
API_UPSTREAM_URL=http://localhost:8000

# Share page SSR
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: used by frontend-ts when generating share links
# VITE_SHARE_BASE_URL=http://localhost:3000
