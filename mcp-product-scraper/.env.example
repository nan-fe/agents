# MCP Bearer 鉴权（≥16 字符）
MCP_BEARER_TOKEN=change-me-to-a-long-random-token

# HTTP 监听
MCP_HOST=0.0.0.0
MCP_PORT=3100
MCP_PATH=/mcp

# 启动时预热 RAG 向量索引
MCP_WARM_RAG_ON_START=true

# 与 backend 共用 Chroma 路径（默认 ../backend/chroma_taobao_v1）
# CHROMA_DB_PATH=/absolute/path/to/chroma_taobao_v1

# 可选：覆盖商品 CSV 路径
# MCP_PRODUCTS_CSV=

# LLM / Playwright 等密钥请在 ../backend/.env 中配置
